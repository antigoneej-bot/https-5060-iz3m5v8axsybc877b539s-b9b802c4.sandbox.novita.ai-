+            decoration:const InputDecoration(labelText:'암호 다시 입력 (12자 이상)'), onChanged:(_)=>update((){})),
+        ])),
+        actions:[TextButton(onPressed:()=>Navigator.pop(context), child:const Text('취소')),
+          TextButton(onPressed: controller.text.isNotEmpty && (!creating || (controller.text.length >= 12 && controller.text == confirm.text))
