+    if (bools.contains(name) || RegExp(r'^care_bonus_given_\d{4}-\d{2}-\d{2}$').hasMatch(name)) return 'bool';
+    if (strings.contains(name)) return 'string';
+    if (lists.contains(name)) return 'strings';
