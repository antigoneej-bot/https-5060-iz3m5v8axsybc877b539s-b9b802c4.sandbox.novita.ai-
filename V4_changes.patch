+        _status('이 기기에 암호화 임시저장');
+      } catch (_) { _failed = true; _status('임시저장 실패 · 내용을 복사해 보관해 주세요'); }
+    });
+    await _tail;
+  }
+  Future<void> discard() async {
+    _timer?.cancel();
+    _discarded = true;
+    _lastText = '';
+    _loadingText = true;
+    if (!_disposed) clear();
+    _loadingText = false;
+    await _ready;
+    _tail = _tail.catchError((Object _) {}).then((_) async {
