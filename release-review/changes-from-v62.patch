+  /// One persisted snapshot contains receipt, food and currency together.
+  Future<void> receiveWalkReward(String id, Map<String, int> reward,
+      {required bool Function() isCurrentOwner}) async {
+    if (!RegExp(r'^[a-f0-9]{48}$').hasMatch(id) || reward.keys.any((k) => !['churu','snack','light'].contains(k)) ||
+        reward.values.any((v) => v < 0) || (reward['churu'] ?? 0) > 12 ||
+        (reward['snack'] ?? 0) > 12 || (reward['light'] ?? 0) > 80) {
+      throw ArgumentError('Invalid walk reward');
+    }
+    await _change((data) {
+      if (!isCurrentOwner()) throw StateError('계정이 바뀌었어요.');
+      final receipt = 'walk_$id';
+      if (data.claimedGiftReceipts.contains(receipt)) return data;
+      return data.copy(essence: data.essence + (reward['light'] ?? 0),
+        claimedGiftReceipts: {...data.claimedGiftReceipts, receipt},
+        walkStock: {...data.walkStock,
+          'churu_tuna': (data.walkStock['churu_tuna'] ?? 0) + (reward['churu'] ?? 0),
+          'food_dry': (data.walkStock['food_dry'] ?? 0) + (reward['snack'] ?? 0)});
+    });
+  }
+
+  Future<bool> consumeWalkFood(String item, {required bool Function() isCurrentOwner}) async {
+    var consumed = false;
+    await _change((data) {
+      if (!isCurrentOwner()) throw StateError('계정이 바뀌었어요.');
+      if ((data.walkStock[item] ?? 0) <= 0) return data;
+      consumed = true;
+      return data.copy(walkStock: {...data.walkStock, item: data.walkStock[item]! - 1});
+    });
+    return consumed;
+  }
